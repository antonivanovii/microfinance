{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["node"],
    "noEmit": true,
    // Vite 8 грузит конфиг нативно и требует расширение в импорте.
    // Здесь это безопасно: ничего не эмитим.
    "allowImportingTsExtensions": true
  },
  "include": [
    "vite.shared.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "eslint.config.js",
    "apps/*/vite.config.ts"
  ]
}
